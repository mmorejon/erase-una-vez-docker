{
    "serviceName": "erase-una-vez-2",
    "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/AppEcsEcrRole",
    "infrastructureRoleArn": "arn:aws:iam::ACCOUNT_ID:role/AppEcsInfraRole",
    "primaryContainer": {
        "image": "ACCOUNT_ID.dkr.ecr.eu-west-1.amazonaws.com/erase-una-vez-2:v0.5.0",
        "containerPort": 8000,
        "environment": [
            {
                "name": "SLEEP_TIME",
                "value": "10s"
            }
        ]
    },
    "cpu": "1 vCPU",
    "memory": "2 GB",
    "healthCheckPath": "/healthz"
}
